        <script><![CDATA[var rightNow = new GlideDateTime();
var before24 = new GlideDateTime(rightNow);
before24.addDaysUTC(-1);

var overDueNITTask = new GlideRecord('x_58872_needit_needit_task');
overDueNITTask.addQuery('due_date', '<=', rightNow);
overDueNITTask.addQuery('due_date', '>=', before24);
overDueNITTask.addQuery('state', '!=', 3);
overDueNITTask.query();

while(overDueNITTask.next()) {
	gs.info("Overdue NeedIt Task record = " + overDueNITTask.number);
	gs.info("Overdue NeedIt Task record = " + gs.getUserName());
